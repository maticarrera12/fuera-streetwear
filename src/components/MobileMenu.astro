---
const links = [
  { href: '/shop/', label: 'SHOP', n: '01' },
  { href: '/lookbook/', label: 'LOOKBOOK', n: '02' },
  { href: '/about/', label: 'ABOUT', n: '03' },
];
---

<div id="menu" hidden role="dialog" aria-modal="true" aria-label="Menú" class="animate-fade-in fixed inset-0 z-90 flex flex-col overflow-auto bg-azul px-5 pb-7 text-crema">
  <div class="flex h-[62px] items-center justify-between border-b-2 border-crema">
    <span class="font-display text-2xl tracking-[-.03em]">FUERA®</span>
    <button type="button" data-close class="min-h-11 cursor-pointer text-[13px] font-bold tracking-[.14em]">CERRAR</button>
  </div>
  <nav aria-label="Menú móvil" class="mt-6 flex flex-col">
    {links.map((l) => (
      <a href={l.href} class="flex items-baseline gap-3.5 border-b border-crema/25 py-3.5 font-display text-[clamp(44px,13vw,72px)] leading-[.9] tracking-[-.03em]">
        <span class="font-sans text-xs font-bold text-lima">{l.n}</span>{l.label}
      </a>
    ))}
  </nav>
  <div class="mt-auto flex flex-col gap-3 pt-10">
    <a href="#newsletter" class="btn-lima h-14 justify-between px-5">ENTERATE ANTES <span aria-hidden="true">→</span></a>
    <span class="text-xs">Drop 001 — Buenos Aires, AR · Ecommerce conceptual</span>
  </div>
</div>
