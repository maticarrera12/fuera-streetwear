---
const nav = [
  { href: '/shop/', label: 'SHOP' },
  { href: '/lookbook/', label: 'LOOKBOOK' },
  { href: '/about/', label: 'ABOUT' },
];
const actionBtn = 'flex min-h-11 cursor-pointer items-center gap-2 px-1.5 text-[13px] font-semibold tracking-[.14em]';
---

<header class="[view-transition-name:site-header] sticky top-0 z-50 border-b-2 border-azul bg-crema text-azul">
  <div class="grid h-[60px] grid-cols-[1fr_auto_1fr] items-center gap-4 px-[clamp(16px,3vw,40px)]">
    <a href="/" aria-label="FUERA® — inicio" class="group flex items-start gap-px justify-self-start font-display text-2xl leading-none tracking-[-.03em]">
      FUERA<span class="mt-px font-sans text-[11px] font-bold transition-[rotate] duration-500 ease-out group-hover:rotate-360">®</span>
    </a>

    <nav aria-label="Principal" class="flex gap-9 text-[13px] font-semibold tracking-[.14em] max-[899px]:hidden">
      {nav.map((l) => <a href={l.href} class="link-u py-2">{l.label}</a>)}
    </nav>
    <span class="min-[900px]:hidden"></span>

    <div class="flex items-center gap-[clamp(4px,1.5vw,20px)] justify-self-end">
      <button type="button" data-open="search" aria-label="Buscar productos" class={actionBtn}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6.5" cy="6.5" r="5"></circle><line x1="10.2" y1="10.2" x2="15" y2="15"></line></svg>
        <span class="max-[899px]:hidden">BUSCAR</span>
      </button>
      <a href="/wishlist/" aria-label="Favoritos" class={actionBtn}>
        <svg width="18" height="16" viewBox="0 0 18 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14.5S1.5 10 1.5 5.2A3.7 3.7 0 0 1 9 3.9a3.7 3.7 0 0 1 7.5 1.3C16.5 10 9 14.5 9 14.5Z"></path></svg>
        <span class="max-[899px]:hidden">FAVORITOS</span>
        <span data-wish-count hidden class="inline-flex h-6 min-w-6 items-center justify-center rounded-xl bg-azul px-[7px] text-xs tracking-normal text-lima">0</span>
      </a>
      <button type="button" data-open="cart" data-cart-trigger aria-label="Abrir carrito, 0 productos" class={actionBtn}>
        <span class="max-[899px]:hidden">CARRITO</span>
        <svg class="min-[900px]:hidden" width="16" height="18" viewBox="0 0 16 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="5" width="14" height="12"></rect><path d="M5 5V4a3 3 0 0 1 6 0v1"></path></svg>
        <span data-cart-count class="inline-flex h-6 min-w-6 items-center justify-center rounded-xl bg-azul px-[7px] text-xs tracking-normal text-lima transition-transform duration-250 ease-[cubic-bezier(.3,1.6,.5,1)] data-[bump]:scale-130">0</span>
      </button>
      <button type="button" data-open="menu" aria-label="Abrir menú" aria-expanded="false" class="min-h-11 cursor-pointer pl-2 pr-1 text-[13px] font-bold tracking-[.14em] min-[900px]:hidden">MENÚ</button>
    </div>
  </div>
</header>
