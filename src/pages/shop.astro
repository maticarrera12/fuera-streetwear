---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORIES, PRODUCTS } from '../data/products';

const sizes = ['S', 'M', 'L', 'XL', 'XXL', 'ÚNICO'].filter((s) => PRODUCTS.some((p) => p.sizes.includes(s) && !p.soldOut.includes(s)));
const colors = [...new Map(PRODUCTS.flatMap((p) => p.colors).map((c) => [c.id, c])).values()];
const countBy = (cat: string) => PRODUCTS.filter((p) => p.category === cat).length;

const label = 'text-[11px] font-bold uppercase tracking-[.14em]';
const chip = 'chip inline-flex h-9 items-center gap-2 border-2 border-azul px-3.5 text-xs font-bold uppercase tracking-[.1em] transition-colors duration-150 ease-out hover:bg-azul/10 aria-pressed:bg-azul aria-pressed:text-crema';
---

<Layout title="Shop — FUERA®">
  <main data-shop data-screen-label="Shop" class="bg-crema px-[clamp(20px,3vw,40px)] pb-[clamp(72px,9vw,128px)] pt-5 text-azul">
    <nav aria-label="Ruta" class="a-rise mb-6 flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-[.14em]">
      <a href="/" class="hover:underline">Inicio</a><span aria-hidden="true">/</span>
      <span aria-current="page">Shop</span>
    </nav>

    <header class="mb-8 flex flex-wrap items-end justify-between gap-x-12 gap-y-4 border-b-2 border-azul pb-6">
      <h1 class="display text-[clamp(52px,9vw,140px)] leading-[.86] tracking-[-.035em]">Shop</h1>
      <p class="max-w-[340px] text-base leading-normal text-pretty">Todo Drop 001 en un solo lugar. Filtrá por categoría, talle o color.</p>
    </header>

    <div class="mb-8 flex flex-col gap-5" role="group" aria-label="Filtros">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class={`${label} w-20`}>Categoría</span>
        <button type="button" class={chip} data-filter="cat" data-value="" aria-pressed="true">Todo <span class="tabular-nums opacity-70">{PRODUCTS.length}</span></button>
        {CATEGORIES.map((c) => <button type="button" class={chip} data-filter="cat" data-value={c.id} aria-pressed="false">{c.label} <span class="tabular-nums opacity-70">{countBy(c.id)}</span></button>)}
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class={`${label} w-20`}>Talle</span>
        {sizes.map((s) => <button type="button" class={chip} data-filter="size" data-value={s} aria-pressed="false">{s}</button>)}
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class={`${label} w-20`}>Color</span>
        {colors.map((c) => (
          <button type="button" class={chip} data-filter="color" data-value={c.id} aria-pressed="false">
            <span aria-hidden="true" class="size-3 rounded-full shadow-[0_0_0_1.5px_currentColor]" style={`background:${c.bg}`}></span>{c.name}
          </button>
        ))}
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-azul/30 pt-4">
        <p class="text-sm" aria-live="polite"><span data-shop-count class="font-bold tabular-nums">{PRODUCTS.length}</span> <span data-shop-count-label>piezas</span></p>
        <div class="flex items-center gap-3">
          <button type="button" data-shop-reset hidden class="link-u py-1 text-xs font-bold uppercase tracking-[.14em]">Limpiar filtros</button>
          <label class="flex items-center gap-2.5">
            <span class={label}>Ordenar</span>
            <select data-shop-sort class="h-9 cursor-pointer border-2 border-azul bg-crema px-2.5 text-xs font-bold uppercase tracking-[.1em]">
              <option value="default">Destacados</option>
              <option value="price-asc">Precio: menor a mayor</option>
              <option value="price-desc">Precio: mayor a menor</option>
            </select>
          </label>
        </div>
      </div>
    </div>

    <ul data-shop-grid class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,240px),1fr))] gap-x-[clamp(14px,1.6vw,24px)] gap-y-[clamp(28px,3vw,40px)]">
      {PRODUCTS.map((p, i) => (
        <li
          data-product
          data-order={i}
          data-cat={p.category}
          data-price={p.price}
          data-colors={p.colors.map((c) => c.id).join(' ')}
          data-sizes={p.sizes.filter((s) => !p.soldOut.includes(s)).join(' ')}
        >
          <ProductCard product={p} index={i} />
        </li>
      ))}
    </ul>

    <div data-shop-empty hidden class="flex flex-col items-start gap-5 border-2 border-azul p-[clamp(24px,4vw,48px)]">
      <p class="display text-[clamp(28px,4vw,52px)] leading-[.95]">Nada por acá.</p>
      <p class="max-w-[40ch] text-base leading-normal">Ninguna pieza coincide con esa combinación de filtros.</p>
      <button type="button" data-shop-reset class="btn-lima h-12 px-5">LIMPIAR FILTROS <span aria-hidden="true">→</span></button>
    </div>

    <p class="mt-10 text-xs tracking-[.04em]">Precios en ARS, ficticios. FUERA® es una marca conceptual: no hay stock ni ventas reales.</p>
  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-shop]')!;
  const grid = root.querySelector<HTMLElement>('[data-shop-grid]')!;
  const items = [...grid.querySelectorAll<HTMLElement>('[data-product]')];
  const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sort = root.querySelector<HTMLSelectElement>('[data-shop-sort]')!;
  const empty = root.querySelector<HTMLElement>('[data-shop-empty]')!;
  const resets = [...root.querySelectorAll<HTMLElement>('[data-shop-reset]')];
  const countEl = root.querySelector<HTMLElement>('[data-shop-count]')!;
  const countLabel = root.querySelector<HTMLElement>('[data-shop-count-label]')!;

  type Key = 'cat' | 'size' | 'color';
  const state: Record<Key, string> = { cat: '', size: '', color: '' };
  const valid = (k: Key) => new Set(chips.filter((c) => c.dataset.filter === k).map((c) => c.dataset.value!));

  // Hydrate from the URL, ignoring values that don't match a real filter.
  const params = new URLSearchParams(location.search);
  (['cat', 'size', 'color'] as Key[]).forEach((k) => {
    const v = params.get(k) ?? '';
    if (valid(k).has(v)) state[k] = v;
  });
  if (['price-asc', 'price-desc'].includes(params.get('sort') ?? '')) sort.value = params.get('sort')!;

  const matches = (el: HTMLElement) =>
    (!state.cat || el.dataset.cat === state.cat) &&
    (!state.size || el.dataset.sizes!.split(' ').includes(state.size)) &&
    (!state.color || el.dataset.colors!.split(' ').includes(state.color));

  function render() {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(state[c.dataset.filter as Key] === c.dataset.value)));

    const dir = sort.value === 'price-asc' ? 1 : sort.value === 'price-desc' ? -1 : 0;
    const ordered = [...items].sort((a, b) => (dir ? dir * (Number(a.dataset.price) - Number(b.dataset.price)) : Number(a.dataset.order) - Number(b.dataset.order)));
    ordered.forEach((el) => grid.append(el));

    let shown = 0;
    items.forEach((el) => {
      const ok = matches(el);
      el.hidden = !ok;
      if (ok) shown++;
    });

    const active = Object.values(state).some(Boolean);
    countEl.textContent = String(shown);
    countLabel.textContent = shown === 1 ? 'pieza' : 'piezas';
    grid.hidden = shown === 0;
    empty.hidden = shown !== 0;
    resets[0].hidden = !active;

    const q = new URLSearchParams();
    (Object.keys(state) as Key[]).forEach((k) => state[k] && q.set(k, state[k]));
    if (dir) q.set('sort', sort.value);
    const qs = q.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const k = c.dataset.filter as Key;
      // Clicking the active chip clears it (except category, which has an explicit "Todo").
      state[k] = state[k] === c.dataset.value && k !== 'cat' ? '' : c.dataset.value!;
      render();
    }),
  );
  sort.addEventListener('change', render);
  resets.forEach((r) => r.addEventListener('click', () => {
    state.cat = state.size = state.color = '';
    sort.value = 'default';
    render();
  }));

  render();
</script>
