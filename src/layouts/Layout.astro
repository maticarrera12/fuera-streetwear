---
import '../styles/global.css';
import Announcement from '../components/Announcement.astro';
import Header from '../components/Header.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { PRODUCTS } from '../data/products';

interface Props {
  title?: string;
}
const { title = 'FUERA® — Independent Streetwear · Drop 001' } = Astro.props;
const ogImage = 'https://images.unsplash.com/photo-1649114383220-c4f0f0dbafbe?auto=format&fit=crop&w=1200&q=70';
const catalog = Object.fromEntries(
  PRODUCTS.map((p) => [p.slug, { name: p.name, price: p.price, img: p.imgs[0], colors: p.colors.map((c) => ({ id: c.id, name: c.name })) }]),
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content="FUERA® — independent streetwear. Drop 001: remeras de algodón pesado, buzos y gorras para quienes van por su cuenta. Ecommerce conceptual." />
    <meta property="og:title" content="FUERA® — No encajamos. Mejor." />
    <meta property="og:description" content="Drop 001 — Fuera de serie. Uniformes para quienes van por su cuenta." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0E287F" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="absolute -left-[9999px] top-0 z-200 bg-lima px-4 py-3 text-azul focus:left-2 focus:top-2">Saltar al contenido</a>

    <svg width="0" height="0" aria-hidden="true" focusable="false" class="absolute size-0">
      <filter id="fx-brush" x="-20%" y="-60%" width="140%" height="220%"><feTurbulence type="fractalNoise" baseFrequency="0.035 0.6" numOctaves="3" seed="4"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="22"></feDisplacementMap></filter>
      <filter id="fx-stain" x="-40%" y="-40%" width="180%" height="180%"><feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="4" seed="11"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="70"></feDisplacementMap></filter>
    </svg>

    <Announcement />
    <Header />
    <div id="main"></div>
    <slot />
    <Newsletter />
    <Footer />
    <MobileMenu />
    <SearchDialog />
    <CartDrawer />

    <script id="catalog" type="application/json" set:html={JSON.stringify(catalog)} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
